    "params": [
      {
        "paramName": "symbol",
        "label": "Ticker",
        "description": "DSE ticker symbol",
        "type": "text",
        "value": "GP"
      }
    ]
  },

  "dsex_price_performance": {
    "name": "DSEX Historical Performance",
    "description": "Total-return % for a DSE ticker over 1-Week, 1-Month, 3-Month, and 1-Year horizons, calculated from bdshare historical OHLCV data.",
    "category": "DSEX – Company Analysis",
    "type": "table",
    "endpoint": "dsex_price_performance",
    "gridData": { "w": 20, "h": 14 },
    "source": "bdshare (dsebd.org historical archive)",
    "params": [
      {
        "paramName": "symbol",
        "label": "Ticker",
        "description": "DSE ticker symbol",
        "type": "text",
        "value": "GP"
      }
    ]
  },

  "dsex_technical_gauge": {
    "name": "DSEX Moving Average Gauge",
