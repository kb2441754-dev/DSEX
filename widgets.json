{
  "dsex_market_overview": {
    "name": "DSEX Market Overview",
    "description": "Live DSEX index level and key market statistics from the Dhaka Stock Exchange",
    "category": "DSEX",
    "type": "table",
    "endpoint": "dsex_market_overview",
    "gridData": { "w": 20, "h": 12 },
    "source": "Dhaka Stock Exchange (dsebd.org)",
    "params": []
  },

  "dsex_live_prices": {
    "name": "DSEX Live Prices",
    "description": "Live share prices for all DSEX constituents scraped from dsebd.org. Refreshes every 2 minutes.",
    "category": "DSEX",
    "type": "table",
    "endpoint": "dsex_live_prices",
    "gridData": { "w": 20, "h": 28 },
    "source": "Dhaka Stock Exchange (dsebd.org)",
    "params": [
      {
        "paramName": "sector",
        "label": "Sector",
        "description": "Filter live prices by sector",
        "type": "text",
        "value": "All",
        "options": [
          { "label": "All Sectors",            "value": "All" },
          { "label": "Financial Services",     "value": "Financial Services" },
          { "label": "Healthcare",             "value": "Healthcare" },
          { "label": "Consumer Staples",       "value": "Consumer Staples" },
          { "label": "Consumer Discretionary", "value": "Consumer Discretionary" },
          { "label": "Industrials",            "value": "Industrials" },
          { "label": "Technology",             "value": "Technology" },
          { "label": "Energy",                 "value": "Energy" },
          { "label": "Utilities",              "value": "Utilities" },
          { "label": "Basic Materials",        "value": "Basic Materials" },
          { "label": "Real Estate",            "value": "Real Estate" }
        ]
      }
    ]
  },

  "dsex_top_gainers": {
    "name": "DSEX Top Gainers",
    "description": "Top performing DSEX stocks by percentage gain today",
    "category": "DSEX",
    "type": "table",
    "endpoint": "dsex_top_gainers",
    "gridData": { "w": 20, "h": 18 },
    "source": "Dhaka Stock Exchange (dsebd.org)",
    "params": [
      {
        "paramName": "limit",
        "label": "Top N",
        "description": "Number of top gainers to display",
        "type": "number",
        "value": "20"
      }
    ]
  },

  "dsex_top_losers": {
    "name": "DSEX Top Losers",
    "description": "Worst performing DSEX stocks by percentage loss today",
    "category": "DSEX",
    "type": "table",
    "endpoint": "dsex_top_losers",
    "gridData": { "w": 20, "h": 18 },
    "source": "Dhaka Stock Exchange (dsebd.org)",
    "params": [
      {
        "paramName": "limit",
        "label": "Top N",
        "description": "Number of top losers to display",
        "type": "number",
        "value": "20"
      }
    ]
  },

  "dsex_constituents": {
    "name": "DSEX Constituents",
    "description": "Full list of all 389 DSEX constituents with sector, industry, and exchange metadata",
    "category": "DSEX",
    "type": "table",
    "endpoint": "dsex_constituents",
    "gridData": { "w": 40, "h": 22 },
    "source": "Dhaka Stock Exchange (DSE)",
    "params": [
      {
        "paramName": "sector",
        "label": "Sector",
        "description": "Filter by sector",
        "type": "text",
        "value": "All",
        "options": [
          { "label": "All Sectors",            "value": "All" },
          { "label": "Financial Services",     "value": "Financial Services" },
          { "label": "Healthcare",             "value": "Healthcare" },
          { "label": "Consumer Discretionary", "value": "Consumer Discretionary" },
          { "label": "Consumer Staples",       "value": "Consumer Staples" },
          { "label": "Industrials",            "value": "Industrials" },
          { "label": "Technology",             "value": "Technology" },
          { "label": "Energy",                 "value": "Energy" },
          { "label": "Utilities",              "value": "Utilities" },
          { "label": "Basic Materials",        "value": "Basic Materials" },
          { "label": "Real Estate",            "value": "Real Estate" }
        ]
      },
      {
        "paramName": "industry",
        "label": "Industry",
        "description": "Filter by industry (e.g. Banking, Pharmaceuticals, Textiles)",
        "type": "text",
        "value": "All"
      }
    ]
  },

  "dsex_sector_summary": {
    "name": "DSEX Sector Breakdown",
    "description": "Number of listed DSEX companies per sector and industry",
    "category": "DSEX",
    "type": "table",
    "endpoint": "dsex_sector_summary",
    "dataKey": "sector_summary",
    "gridData": { "w": 20, "h": 18 },
    "source": "Dhaka Stock Exchange (DSE)",
    "params": []
  },

  "dsex_sector_chart": {
    "name": "DSEX Sector Distribution Chart",
    "description": "Plotly chart showing the distribution of DSEX constituents across sectors",
    "category": "DSEX",
    "type": "chart",
    "endpoint": "dsex_sector_chart",
    "gridData": { "w": 20, "h": 18 },
    "source": "Dhaka Stock Exchange (DSE)",
    "params": [
      {
        "paramName": "chart_type",
        "label": "Chart Type",
        "description": "Choose bar or pie chart",
        "type": "text",
        "value": "bar",
        "options": [
          { "label": "Bar Chart", "value": "bar" },
          { "label": "Pie Chart", "value": "pie" }
        ]
      }
    ]
  },

  "dsex_tv_chart": {
    "name": "DSEX TradingView Chart",
    "description": "Interactive TradingView candlestick chart powered by a native UDF feed. Supports daily, weekly, and monthly resolutions for any DSE-listed ticker.",
    "category": "DSEX",
    "type": "advanced_charting",
    "widgetType": "tradingview",
    "endpoint": "/udf",
    "searchEndpoint": "/udf/search",
    "gridData": { "w": 20, "h": 28 },
    "source": "Dhaka Stock Exchange (bdshare / dsebd.org)",
    "data": {
      "defaultSymbol": "GP",
      "updateFrequency": 60000,
      "chartConfig": {
        "upColor":         "#26a69a",
        "downColor":       "#ef5350",
        "borderUpColor":   "#26a69a",
        "borderDownColor": "#ef5350",
        "wickUpColor":     "#26a69a",
        "wickDownColor":   "#ef5350",
        "volumeUpColor":   "#26a69a80",
        "volumeDownColor": "#ef535080",
        "showVolume": true
      }
    },
    "params": [
      {
        "paramName": "symbol",
        "label": "Ticker",
        "description": "DSE ticker symbol (e.g. GP, SQURPHARMA, BRACBANK)",
        "type": "text",
        "value": "GP"
      }
    ]
  },

  "dsex_ticker_profile": {
    "name": "DSEX Company Profile",
    "description": "Key metadata for a DSE-listed company: ticker, full name, sector, industry, region, and trading venue.",
    "category": "DSEX – Company Analysis",
    "type": "table",
    "endpoint": "dsex_ticker_profile",
    "gridData": { "w": 20, "h": 14 },
    "source": "DSEX.csv (static metadata)",
    "params": [
      {
        "paramName": "symbol",
        "label": "Ticker",
        "description": "DSE ticker symbol (e.g. GP, RENATA, BRACBANK)",
        "type": "text",
        "value": "GP"
      }
    ]
  },

  "dsex_valuation_metrics": {
    "name": "DSEX Valuation Multiples",
    "description": "Live fundamental metrics scraped from dsebd.org: Market Cap, P/E Ratio, EPS, Dividend Yield, Face Value, and Authorised Capital.",
