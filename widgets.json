  "dsex_tv_chart": {
    "name": "DSEX TradingView Chart",
    "description": "Interactive TradingView candlestick chart. UDF feed powered by direct dsebd.org scraping (day_end_archive.php). Supports D / W / M resolutions.",
    "category": "DSEX",
    "type": "advanced_charting",
    "widgetType": "tradingview",
    "endpoint": "/udf",
    "searchEndpoint": "/udf/search",
    "gridData": {
      "w": 20,
      "h": 28
    },
    "source": "dsebd.org — day_end_archive.php",
    "data": {
      "defaultSymbol": "GP",
      "updateFrequency": 60000,
      "chartConfig": {
        "upColor": "#26a69a",
        "downColor": "#ef5350",
        "borderUpColor": "#26a69a",
        "borderDownColor": "#ef5350",
        "wickUpColor": "#26a69a",
        "wickDownColor": "#ef5350",
        "volumeUpColor": "#26a69a80",
        "volumeDownColor": "#ef535080",
        "showVolume": true
      }
    },
    "params": [
      {
        "paramName": "symbol",
        "label": "Ticker",
        "description": "DSE ticker symbol (e.g. GP, SQURPHARMA, BRACBANK)",
        "type": "text",
        "value": "GP"
      }
    ]
  },
